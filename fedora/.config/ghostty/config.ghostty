theme = light: light.ghostty, dark: dark.ghostty

font-family = CommitMonoV143
font-style = 550 Regular
font-style-bold = 700 Regular
font-style-italic = 550 Italic
font-style-bold-italic = 700 Italic
font-feature = ss02, ss05, cv01, cv02
font-size = 11
adjust-cell-height = 25%

title = " "
window-padding-y = 0
window-padding-balance = true
window-decoration = none
mouse-hide-while-typing = true
confirm-close-surface = false

shell-integration = zsh
