theme = light: light.ghostty, dark: dark.ghostty

font-family = Source Code Pro
font-style = SemiBold
font-style-bold = Black
font-style-italic = SemiBold Italic
font-style-bold-italic = Black Italic
font-feature = ss02, ss03, ss07, zero
font-size = 15
adjust-cell-height = 30%
font-thicken = true

title = " "
window-padding-y = 0
window-padding-balance = true
mouse-hide-while-typing = true
confirm-close-surface = false

shell-integration = zsh
