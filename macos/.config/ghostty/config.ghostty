theme = light: light.ghostty, dark: dark.ghostty

font-family = IBM Plex Mono
font-style = Medium
font-size = 15
font-thicken = true
adjust-cell-height = 15%

title = " "
window-padding-y = 0
window-padding-balance = true
mouse-hide-while-typing = true
confirm-close-surface = false

shell-integration = zsh
