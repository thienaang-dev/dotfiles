theme = light: light.ghostty, dark: dark.ghostty

font-family = Recursive Mono Casual Static
font-style = Medium
font-feature = -calt, -liga, -dlig, ss01, ss02, ss03, ss04, ss05, ss06, ss07, ss08, ss09, ss10, ss11, ss12
font-variation-bold = wght=900
font-size = 14
font-thicken = true
adjust-cell-height = 20%

title = " "
window-padding-y = 0
window-padding-balance = true
mouse-hide-while-typing = true
confirm-close-surface = false

shell-integration = zsh
